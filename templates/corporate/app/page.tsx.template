import Link from "next/link";
const pages=[["Company","/company"],["Services","/services"],["Contact","/contact"]];
export default function Home(){return <><header className="header"><nav className="container nav" aria-label="Main navigation"><Link className="brand" href="/">__PROJECT_NAME__</Link><div className="nav-links">{pages.map(([name,href])=><Link key={href} href={href}>{name}</Link>)}</div></nav></header><main id="main"><section className="container hero"><p className="eyebrow">Corporate website starter</p><h1>__PROJECT_NAME__.</h1><p className="lead">A foundation for your company's own story. Replace this placeholder with verified, approved positioning before launch.</p><Link className="cta" href="/company">About the company <span aria-hidden="true">↗</span></Link></section><section className="container section"><p className="eyebrow">Explore</p><h2>Designed to evolve.</h2><div className="cards">{pages.map(([name,href])=><Link key={href} href={href} className="card">{name}<span aria-hidden="true">↗</span></Link>)}</div></section></main><footer className="container footer">__PROJECT_NAME__ · Starter content — review before publication</footer></>;}
