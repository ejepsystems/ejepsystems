*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f7f7f5;color:#111;font-family:var(--font-sans),sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}a:focus-visible{outline:2px solid __BRAND_COLOR__;outline-offset:4px}.container{width:min(100% - 40px,1120px);margin-inline:auto}.skip{position:absolute;top:-100px;left:12px;padding:12px;background:#fff;z-index:50}.skip:focus{top:12px}.header{border-bottom:1px solid #dededb}.nav{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-size:19px;font-weight:600;letter-spacing:-.04em}.nav-links{display:flex;flex-wrap:wrap;gap:clamp(12px,3vw,30px);font-size:13px}.hero{padding-block:clamp(90px,14vw,180px);min-height:540px}.eyebrow{font:11px var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase;color:#626265}.hero h1,.inner h1{font-size:clamp(40px,8vw,84px);font-weight:480;line-height:1.06;letter-spacing:-.05em;margin:24px 0}.lead{font-size:clamp(15px,1.7vw,18px);line-height:1.65;max-width:620px;color:#626265}.cta{display:inline-flex;align-items:center;gap:26px;background:__BRAND_COLOR__;color:#fff;padding:15px 20px;margin-top:24px;min-height:48px;border-radius:6px;font-size:14px}.section{padding-block:80px 110px;border-top:1px solid #dededb}.section h2{font-size:clamp(28px,4vw,48px);font-weight:500;letter-spacing:-.04em}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:36px}.card{border:1px solid #dededb;padding:24px;min-height:160px;display:flex;align-items:flex-end;justify-content:space-between;font-size:20px;letter-spacing:-.03em}.card:hover{border-color:__BRAND_COLOR__}.inner{padding-block:clamp(72px,12vw,160px);min-height:70svh}.inner>a:first-child{font-size:13px}.inner .eyebrow{margin-top:80px}.footer{border-top:1px solid #dededb;padding-block:30px;color:#626265;font-size:12px}@media(max-width:600px){.nav{align-items:flex-start;flex-direction:column;padding-block:18px}.nav-links{width:100%;justify-content:space-between}.hero{min-height:460px;padding-block:100px}.hero h1,.inner h1{overflow-wrap:anywhere}.cards{grid-template-columns:1fr}.card{min-height:104px}.inner .eyebrow{margin-top:60px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
